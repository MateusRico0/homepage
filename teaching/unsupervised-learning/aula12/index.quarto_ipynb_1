        "#| echo: false\n",
        "# =====================================================================\n",
        "# SETUP GLOBAL — executado uma vez, estado compartilhado pelos chunks\n",
        "# =====================================================================\n",
        "import warnings\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.nn.functional as F\n",
        "from sklearn.datasets import load_digits\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "plt.style.use(\"seaborn-v0_8-whitegrid\")\n",
        "plt.rcParams.update({\n",
        "    \"figure.dpi\": 125,\n",
        "    \"font.size\": 11,\n",
        "    \"axes.titlesize\": 12,\n",
        "    \"axes.titleweight\": \"bold\",\n",
        "    \"legend.frameon\": True,\n",
        "    \"legend.framealpha\": 0.9,\n",
        "})\n",
        "\n",
        "COR_A = \"#2b5c8f\"\n",
        "COR_B = \"#d95f02\"\n",
        "COR_NEU = \"#7570b3\"\n",
        "COR_CINZA = \"#7f7f7f\"\n",
        "COR_VERDE = \"#1b9e77\"\n",
        "COR_ALERTA = \"#e7298a\"\n",
        "CORES_CLASSE = [COR_A, COR_B, COR_VERDE]\n",
        "\n",
        "\n",
        "def brl(val, dec=2):\n",
        "    return f\"{val:.{dec}f}\".replace(\".\", \",\")\n",
        "\n",
        "\n",
        "def pct(val, dec=1):\n",
        "    return f\"{100 * val:.{dec}f}\".replace(\".\", \",\") + \"%\"\n",
        "\n",
        "\n",
        "def milhar(val):\n",
        "    return f\"{int(val):,}\".replace(\",\", \".\")\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 1. EXPERIMENTO SINTÉTICO: SINAL 2D + RUÍDO 18D DE ALTA VARIÂNCIA\n",
        "# =====================================================================\n",
        "torch.manual_seed(42)\n",
        "rng = np.random.default_rng(42)\n",
        "N_SINT = 1200\n",
        "centros = np.array([[2.5, 0.0], [-1.25, 2.165], [-1.25, -2.165]])\n",
        "y_sint = np.repeat(np.arange(3), N_SINT // 3)\n",
        "X_sinal = centros[y_sint] + rng.normal(0, 0.35, size=(N_SINT, 2))\n",
        "X_nuis = rng.normal(0, 3.0, size=(N_SINT, 18))\n",
        "X_sint = np.hstack([X_sinal, X_nuis]).astype(np.float32)\n",
        "\n",
        "Xs_tr, Xs_te, ys_tr, ys_te = train_test_split(\n",
        "    X_sint, y_sint, test_size=0.3, stratify=y_sint, random_state=42\n",
        ")\n",
        "Xt_tr, Xt_te = torch.from_numpy(Xs_tr), torch.from_numpy(Xs_te)\n",
        "\n",
        "# PCA 2D\n",
        "pca_s = PCA(n_components=2).fit(Xs_tr)\n",
        "Z_pca_s_tr, Z_pca_s_te = pca_s.transform(Xs_tr), pca_s.transform(Xs_te)\n",
        "acc_pca_s = LogisticRegression(max_iter=1000).fit(Z_pca_s_tr, ys_tr).score(Z_pca_s_te, ys_te)\n",
        "\n",
        "\n",
        "# Autoencoder 2D\n",
        "class SimpleAE(nn.Module):\n",
        "    def __init__(self, d_in, d_lat):\n",
        "        super().__init__()\n",
        "        self.enc = nn.Sequential(nn.Linear(d_in, 32), nn.ReLU(), nn.Linear(32, d_lat))\n",
        "        self.dec = nn.Sequential(nn.Linear(d_lat, 32), nn.ReLU(), nn.Linear(32, d_in))\n",
        "\n",
        "    def forward(self, x):\n",
        "        h = self.enc(x)\n",
        "        return self.dec(h), h\n",
        "\n",
        "\n",
        "ae_s = SimpleAE(20, 2)\n",
        "opt = torch.optim.Adam(ae_s.parameters(), lr=1e-2)\n",
        "for _ in range(120):\n",
        "    rec, _ = ae_s(Xt_tr)\n",
        "    loss = F.mse_loss(rec, Xt_tr)\n",
        "    opt.zero_grad()\n",
        "    loss.backward()\n",
        "    opt.step()\n",
        "with torch.no_grad():\n",
        "    _, Z_ae_s_tr = ae_s(Xt_tr)\n",
        "    _, Z_ae_s_te = ae_s(Xt_te)\n",
        "Z_ae_s_tr, Z_ae_s_te = Z_ae_s_tr.numpy(), Z_ae_s_te.numpy()\n",
        "acc_ae_s = LogisticRegression(max_iter=1000).fit(Z_ae_s_tr, ys_tr).score(Z_ae_s_te, ys_te)\n",
        "\n",
        "\n",
        "def aug_sint(x):\n",
        "    \"\"\"Perturba fortemente o fundo (colunas 2..19) e levemente o sinal (0..1).\"\"\"\n",
        "    v = x.clone()\n",
        "    v[:, :2] += 0.15 * torch.randn_like(v[:, :2])\n",
        "    v[:, 2:] = 0.5 * v[:, 2:] + 2.5 * torch.randn_like(v[:, 2:])\n",
        "    return v\n",
        "\n",
        "\n",
        "def infonce_loss(z1, z2, tau=0.2):\n",
        "    B = z1.shape[0]\n",
        "    z = torch.cat([z1, z2], dim=0)\n",
        "    sim = (z @ z.T) / tau\n",
        "    mask = torch.eye(2 * B, dtype=torch.bool)\n",
        "    sim = sim.masked_fill(mask, -1e9)\n",
        "    pos_idx = torch.cat([torch.arange(B, 2 * B), torch.arange(0, B)])\n",
        "    return F.cross_entropy(sim, pos_idx)\n",
        "\n",
        "\n",
        "class ContrastiveSint(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(nn.Linear(20, 32), nn.ReLU(), nn.Linear(32, 2))\n",
        "\n",
        "    def forward(self, x):\n",
        "        return F.normalize(self.net(x), dim=-1)\n",
        "\n",
        "\n",
        "# Sem negativos (colapso)\n",
        "col_s = ContrastiveSint()\n",
        "opt = torch.optim.Adam(col_s.parameters(), lr=2e-2)\n",
        "for _ in range(150):\n",
        "    z1, z2 = col_s(aug_sint(Xt_tr)), col_s(aug_sint(Xt_tr))\n",
        "    loss = ((z1 - z2) ** 2).sum(-1).mean()\n",
        "    opt.zero_grad()\n",
        "    loss.backward()\n",
        "    opt.step()\n",
        "with torch.no_grad():\n",
        "    Z_col_s_tr, Z_col_s_te = col_s(Xt_tr).numpy(), col_s(Xt_te).numpy()\n",
        "std_col_s = float(Z_col_s_te.std(0).mean())\n",
        "acc_col_s = LogisticRegression(max_iter=1000).fit(Z_col_s_tr, ys_tr).score(Z_col_s_te, ys_te)\n",
        "\n",
        "# Com InfoNCE\n",
        "con_s = ContrastiveSint()\n",
        "opt = torch.optim.Adam(con_s.parameters(), lr=1e-2)\n",
        "for _ in range(180):\n",
        "    idx = torch.randperm(len(Xt_tr))[:128]\n",
        "    xb = Xt_tr[idx]\n",
        "    z1, z2 = con_s(aug_sint(xb)), con_s(aug_sint(xb))\n",
        "    loss = infonce_loss(z1, z2, tau=0.2)\n",
        "    opt.zero_grad()\n",
        "    loss.backward()\n",
        "    opt.step()\n",
        "with torch.no_grad():\n",
        "    Z_con_s_tr, Z_con_s_te = con_s(Xt_tr).numpy(), con_s(Xt_te).numpy()\n",
        "acc_con_s = LogisticRegression(max_iter=1000).fit(Z_con_s_tr, ys_tr).score(Z_con_s_te, ys_te)\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# 2. EXPERIMENTO REAL: DIGITOS (8x8 = 64D, 10 CLASSES)\n",
        "# =====================================================================\n",
        "digits = load_digits()\n",
        "Xd = (digits.data / 16.0).astype(np.float32)\n",
        "yd = digits.target\n",
        "Xd_tr, Xd_te, yd_tr, yd_te = train_test_split(\n",
        "    Xd, yd, test_size=0.3, stratify=yd, random_state=42\n",
        ")\n",
        "n_dig_tr, n_dig_te = len(Xd_tr), len(Xd_te)\n",
        "\n",
        "acc_raw = LogisticRegression(max_iter=1000).fit(Xd_tr, yd_tr).score(Xd_te, yd_te)\n",
        "pca_d = PCA(n_components=32).fit(Xd_tr)\n",
        "acc_pca_d = LogisticRegression(max_iter=1000).fit(pca_d.transform(Xd_tr), yd_tr).score(pca_d.transform(Xd_te), yd_te)\n",
        "\n",
        "# Autoencoder 32D\n",
        "ae_d = SimpleAE(64, 32)\n",
        "opt = torch.optim.Adam(ae_d.parameters(), lr=3e-3)\n",
        "Xdt_tr, Xdt_te = torch.from_numpy(Xd_tr), torch.from_numpy(Xd_te)\n",
        "for _ in range(100):\n",
        "    perm = torch.randperm(len(Xdt_tr))\n",
        "    for i in range(0, len(Xdt_tr) - 128 + 1, 128):\n",
        "        xb = Xdt_tr[perm[i:i + 128]]\n",
        "        rec, _ = ae_d(xb)\n",
        "        loss = F.mse_loss(rec, xb)\n",
        "        opt.zero_grad()\n",
        "        loss.backward()\n",
        "        opt.step()\n",
        "with torch.no_grad():\n",
        "    _, hd_tr = ae_d(Xdt_tr)\n",
        "    _, hd_te = ae_d(Xdt_te)\n",
        "acc_ae_d = LogisticRegression(max_iter=1000).fit(hd_tr.numpy(), yd_tr).score(hd_te.numpy(), yd_te)\n",
        "\n",
        "\n",
        "def aug_digits(x):\n",
        "    \"\"\"Aumentacao estocastica vetorizada em 8x8: deslocamento +-1 px, brilho, dropout e ruido.\"\"\"\n",
        "    B = x.shape[0]\n",
        "    img = x.view(B, 1, 8, 8)\n",
        "    dx = torch.randint(-1, 2, (B,))\n",
        "    dy = torch.randint(-1, 2, (B,))\n",
        "    shifted = torch.zeros_like(img)\n",
        "    for sx in (-1, 0, 1):\n",
        "        for sy in (-1, 0, 1):\n",
        "            m = (dx == sx) & (dy == sy)\n",
        "            if m.any():\n",
        "                x_src = slice(max(0, -sx), min(8, 8 - sx))\n",
        "                x_dst = slice(max(0, sx), min(8, 8 + sx))\n",
        "                y_src = slice(max(0, -sy), min(8, 8 - sy))\n",
        "                y_dst = slice(max(0, sy), min(8, 8 + sy))\n",
        "                shifted[m, 0, y_dst, x_dst] = img[m, 0, y_src, x_src]\n",
        "    scale = 0.8 + 0.4 * torch.rand(B, 1, 1, 1)\n",
        "    mask = (torch.rand_like(shifted) > 0.2).float()\n",
        "    out = shifted * scale * mask + 0.06 * torch.randn_like(shifted)\n",
        "    return torch.clamp(out.view(B, 64), 0.0, 1.0)\n",
        "\n",
        "\n",
        "class DigitsEncoder(nn.Module):\n",
        "    def __init__(self, d_h=32, d_z=16):\n",
        "        super().__init__()\n",
        "        self.enc = nn.Sequential(\n",
        "            nn.Linear(64, 128), nn.BatchNorm1d(128), nn.ReLU(),\n",
        "            nn.Linear(128, 64), nn.BatchNorm1d(64), nn.ReLU(),\n",
        "            nn.Linear(64, d_h),\n",
        "        )\n",
        "        self.proj = nn.Sequential(\n",
        "            nn.Linear(d_h, 64), nn.ReLU(),\n",
        "            nn.Linear(64, d_z),\n",
        "        )\n",
        "\n",
        "    def forward(self, x):\n",
        "        h = self.enc(x)\n",
        "        z = F.normalize(self.proj(h), dim=-1)\n",
        "        return h, z\n",
        "\n",
        "\n",
        "def train_digits_simclr(tau=0.2, batch_size=128, epochs=35, seed=0):\n",
        "    torch.manual_seed(seed)\n",
        "    model = DigitsEncoder()\n",
        "    opt = torch.optim.Adam(model.parameters(), lr=4e-3, weight_decay=1e-4)\n",
        "    N = len(Xdt_tr)\n",
        "    for _ in range(epochs):\n",
        "        perm = torch.randperm(N)\n",
        "        for i in range(0, N - batch_size + 1, batch_size):\n",
        "            xb = Xdt_tr[perm[i:i + batch_size]]\n",
        "            _, z1 = model(aug_digits(xb))\n",
        "            _, z2 = model(aug_digits(xb))\n",
        "            loss = infonce_loss(z1, z2, tau=tau)\n",
        "            opt.zero_grad()\n",
        "            loss.backward()\n",
        "            opt.step()\n",
        "    model.eval()\n",
        "    with torch.no_grad():\n",
        "        h_tr, z_tr = model(Xdt_tr)\n",
        "        h_te, z_te = model(Xdt_te)\n",
        "        v1 = model(aug_digits(Xdt_te))[1]\n",
        "        v2 = model(aug_digits(Xdt_te))[1]\n",
        "        align = float(((v1 - v2) ** 2).sum(-1).mean())\n",
        "        sq_pdist = torch.cdist(z_te, z_te, p=2) ** 2\n",
        "        mask = ~torch.eye(len(z_te), dtype=torch.bool)\n",
        "        unif = float(torch.log(torch.exp(-2.0 * sq_pdist[mask]).mean()))\n",
        "    acc_h = LogisticRegression(max_iter=300).fit(h_tr.numpy(), yd_tr).score(h_te.numpy(), yd_te)\n",
        "    acc_z = LogisticRegression(max_iter=300).fit(z_tr.numpy(), yd_tr).score(z_te.numpy(), yd_te)\n",
        "    return acc_h, acc_z, align, unif\n",
        "\n",
        "\n",
        "# Modelo base SimCLR (tau=0.2, B=128)\n",
        "acc_h_base, acc_z_base, align_base, unif_base = train_digits_simclr(tau=0.2, batch_size=128, epochs=35)\n",
        "\n",
        "# Ablacao de temperatura\n",
        "TAUS = [0.02, 0.05, 0.2, 0.5, 2.0]\n",
        "ab_tau = [train_digits_simclr(tau=t, batch_size=128, epochs=35) for t in TAUS]\n",
        "\n",
        "# Ablacao de tamanho do lote (numero de negativos K = 2B - 2)\n",
        "BATCHES = [8, 16, 32, 64, 128]\n",
        "ab_bs = [train_digits_simclr(tau=0.2, batch_size=b, epochs=35) for b in BATCHES]"
      ],
